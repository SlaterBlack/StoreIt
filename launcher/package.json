{
  "name": "@ai3d/storeit-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "StoreIt API and embedded PostgreSQL desktop launcher for Windows and Linux.",
  "author": "AI3D",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build:backend": "node scripts/build-backend.cjs",
