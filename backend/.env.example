NODE_ENV=development
PORT=4002
CLIENT_ORIGINS=http://localhost:2400,http://localhost:2401,http://localhost:2402

# StoreIt PostgreSQL database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=storeit
DB_USER=postgres
DB_PASSWORD=change-me
DB_LOGGING=false

# Shared StoreIt session signing key (use a unique random value outside local development)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Read-only sources used by the one-time migration tool
CLOCKIT_SOURCE_DB_HOST=localhost
CLOCKIT_SOURCE_DB_PORT=5432
CLOCKIT_SOURCE_DB_NAME=clockify_dupe
CLOCKIT_SOURCE_DB_USER=postgres
CLOCKIT_SOURCE_DB_PASSWORD=change-me

MANAGEIT_SOURCE_DB_HOST=localhost
MANAGEIT_SOURCE_DB_PORT=5432
MANAGEIT_SOURCE_DB_NAME=manageit
MANAGEIT_SOURCE_DB_USER=postgres
MANAGEIT_SOURCE_DB_PASSWORD=change-me
