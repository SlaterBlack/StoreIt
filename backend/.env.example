NODE_ENV=development
PORT=4002
API_HOST=127.0.0.1
TRUST_PROXY=loopback
CLIENT_ORIGINS=http://localhost:2400,http://localhost:2401,http://localhost:2402,http://localhost:2404

# Public URLs used by the app switcher. StoreIt checks each URL before listing it.
CLOCKIT_PUBLIC_URL=https://clockit.ai3d.com.au/
MANAGEIT_PUBLIC_URL=https://manageit.ai3d.com.au/
SPLATIT_PUBLIC_URL=https://splatit.ai3d.com.au/

# Read-only SplatIt source; mount the share's GaussianSplats subdirectory here.
SPLATIT_SCENE_ROOT=/MaxResources/GaussianSplats
SPLATIT_ALLOWED_ORIGINS=http://localhost:2404
# Generate a unique random secret of at least 32 characters for production.
SPLATIT_SIGNING_SECRET=

# StoreIt PostgreSQL database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=storeit
DB_USER=postgres
DB_PASSWORD=change-me
DB_LOGGING=false

# Shared StoreIt session signing key (use a unique random value outside local development)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# SMTP is required to send ClockIt scheduled report workbooks.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Read-only sources used by the one-time migration tool
CLOCKIT_SOURCE_DB_HOST=localhost
CLOCKIT_SOURCE_DB_PORT=5432
CLOCKIT_SOURCE_DB_NAME=clockify_dupe
CLOCKIT_SOURCE_DB_USER=postgres
CLOCKIT_SOURCE_DB_PASSWORD=change-me

MANAGEIT_SOURCE_DB_HOST=localhost
MANAGEIT_SOURCE_DB_PORT=5432
MANAGEIT_SOURCE_DB_NAME=manageit
MANAGEIT_SOURCE_DB_USER=postgres
MANAGEIT_SOURCE_DB_PASSWORD=change-me
