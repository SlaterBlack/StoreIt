{
  "name": "storeit-backend",
  "version": "1.0.0",
  "description": "Shared Node/Express/TypeScript API for ClockIt, ManageIt, and SendIt",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "ts-node src/scripts/migrateSchema.ts",
    "admin:create": "ts-node src/scripts/createAdmin.ts",
    "data:check": "ts-node src/scripts/migrateLegacyData.ts",
    "data:migrate": "ts-node src/scripts/migrateLegacyData.ts --apply"
  },
  "keywords": [
    "clockify",
    "time-tracking",
    "express",
    "typescript",
    "sequelize"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "fflate": "^0.8.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.6.1",
    "morgan": "^1.10.0",
    "nodemailer": "^7.0.3",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/luxon": "^3.6.2",
    "@types/morgan": "^1.9.9",
    "@types/nodemailer": "^6.4.17",
    "@types/node": "^22.10.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
